SET_AND_EXPOSE_TO_BUILD(USE_TZONE OFF)
SET_AND_EXPOSE_TO_BUILD(USE_GLIB OFF)
SET_AND_EXPOSE_TO_BUILD(USE_SOUP OFF)
SET_AND_EXPOSE_TO_BUILD(USE_LIBWPE OFF)
SET_AND_EXPOSE_TO_BUILD(USE_TEXTURE_MAPPER OFF)
SET_AND_EXPOSE_TO_BUILD(USE_COORDINATED_GRAPHICS OFF)
