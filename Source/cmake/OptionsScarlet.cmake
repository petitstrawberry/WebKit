add_definitions(-DWTF_PLATFORM_SCARLET=1)
set(PROJECT_VERSION_MAJOR 1)
set(PROJECT_VERSION_MINOR 0)
set(PROJECT_VERSION_MICRO 0)
set(PROJECT_VERSION 1.0.0)
set(CMAKE_C_VISIBILITY_PRESET hidden)
set(CMAKE_CXX_VISIBILITY_PRESET hidden)
set(CMAKE_VISIBILITY_INLINES_HIDDEN ON)

set(ENABLE_JAVASCRIPTCORE ON)
set(ENABLE_WEBCORE ON)
set(ENABLE_WEBKIT OFF)
set(ENABLE_WEBKIT_LEGACY OFF)
set(ENABLE_WEBINSPECTORUI OFF)
set(ENABLE_TOOLS OFF)
set(EVENT_LOOP_TYPE Generic)
set(LOWERCASE_EVENT_LOOP_TYPE generic)
option(SCARLET_BUILD_RENDERER "Build the native direct-WebCore CPU renderer and verification control" OFF)
option(SCARLET_BUILD_EMBEDDING "Build the persistent native Scarlet WebView C ABI" OFF)
option(SCARLET_BUILD_VULKAN_PROBE "Build the native Skia/Vulkan drawing contract probe" OFF)
set(SCARLET_NATIVE_MEMORY_LIBRARY "" CACHE FILEPATH "Native Scarlet shared-memory bridge archive")
set(SCARLET_CXX_RUNTIME_SUPPORT_LIBRARY "" CACHE FILEPATH "Native Scarlet C++ runtime support archive")
set(SCARLET_NATIVE_LIBRARY_ROOTS "" CACHE STRING "Semicolon-separated trusted native Scarlet library prefixes")
set(SCARLET_EMBEDDING_RUNTIME_LIBRARIES "" CACHE STRING "Native C/C++ archives for a Rust embedding; no CRT object")
set(SCARLET_EMBEDDING_LINK_OPTIONS "" CACHE STRING "Raw LLD options for the final embedding executable")

WEBKIT_OPTION_BEGIN()
WEBKIT_OPTION_DEFINE(USE_SYSTEM_UNIFDEF "Use the build-host unifdef executable" PRIVATE ON)
WEBKIT_OPTION_DEFINE(ENABLE_STATIC_JSC "Build native static JSC" PRIVATE ON)
WEBKIT_OPTION_DEFINE(ENABLE_JSC_GLIB_API "Build JSC GLib API" PRIVATE OFF)
WEBKIT_OPTION_DEFINE(USE_LIBBACKTRACE "Use libbacktrace" PRIVATE OFF)
WEBKIT_OPTION_DEFAULT_PORT_VALUE(ENABLE_C_LOOP PRIVATE ON)
WEBKIT_OPTION_DEFAULT_PORT_VALUE(USE_SYSTEM_MALLOC PRIVATE ON)
WEBKIT_OPTION_DEFAULT_PORT_VALUE(USE_WOFF2 PRIVATE ON)
WEBKIT_OPTION_DEFAULT_PORT_VALUE(ENABLE_VIDEO PRIVATE ON)
foreach (feature IN ITEMS
    ENABLE_JIT ENABLE_DFG_JIT ENABLE_FTL_JIT ENABLE_WEBASSEMBLY
    ENABLE_WEBASSEMBLY_BBQJIT ENABLE_WEBASSEMBLY_OMGJIT
    ENABLE_SAMPLING_PROFILER ENABLE_REMOTE_INSPECTOR
    ENABLE_API_TESTS ENABLE_LAYOUT_TESTS ENABLE_MINIBROWSER
    ENABLE_JAVASCRIPT_SHELL ENABLE_EXPERIMENTAL_FEATURES
    ENABLE_GPU_PROCESS ENABLE_WEBGL ENABLE_WEBGPU ENABLE_WEBGPU_SWIFT
    ENABLE_ASYNC_SCROLLING ENABLE_SMOOTH_SCROLLING
    ENABLE_WEB_AUDIO ENABLE_WEB_RTC ENABLE_WEB_CODECS
    ENABLE_MEDIA_CAPTURE ENABLE_MEDIA_STREAM ENABLE_MEDIA_SOURCE
    ENABLE_MEDIA_SOURCE_IN_WORKERS ENABLE_MEDIA_RECORDER
    ENABLE_MEDIA_SESSION ENABLE_ENCRYPTED_MEDIA ENABLE_LEGACY_ENCRYPTED_MEDIA
    ENABLE_FULLSCREEN_API ENABLE_CONTEXT_MENUS ENABLE_DRAG_SUPPORT
    ENABLE_GEOLOCATION ENABLE_NOTIFICATIONS ENABLE_GAMEPAD
    ENABLE_SPEECH_SYNTHESIS ENABLE_RESOURCE_USAGE ENABLE_PERIODIC_MEMORY_MONITOR
    ENABLE_MODEL_ELEMENT ENABLE_WEBXR ENABLE_WEB_AUTHN
    ENABLE_XSLT ENABLE_MATHML ENABLE_USER_MESSAGE_HANDLERS
    ENABLE_VARIATION_FONTS ENABLE_OFFSCREEN_CANVAS ENABLE_OFFSCREEN_CANVAS_IN_WORKERS
    ENABLE_BACK_FORWARD_LIST_SWIFT ENABLE_SWIFT_BASE_CLASS_ANNOTATIONS
    USE_ISO_MALLOC USE_MIMALLOC USE_AVIF USE_JPEGXL USE_LCMS
    USE_SKIA USE_SKIA_ENCODERS)
    WEBKIT_OPTION_DEFAULT_PORT_VALUE(${feature} PRIVATE OFF)
endforeach ()
WEBKIT_OPTION_END()

SET_AND_EXPOSE_TO_BUILD(ENABLE_ACCESSIBILITY OFF)
SET_AND_EXPOSE_TO_BUILD(WTF_DEFAULT_EVENT_LOOP 0)
