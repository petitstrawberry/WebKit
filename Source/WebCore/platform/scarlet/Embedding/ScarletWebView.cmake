# Fork-owned persistent C ABI. Include after the configured WebCore target.
# The archive embeds the engine's otherwise omitted PCH subtarget objects.
# Its manifest retains every native engine/dependency archive, never a main/CRT.
if (NOT PORT STREQUAL "Scarlet" OR NOT TARGET WebCore)
    message(FATAL_ERROR "ScarletWebView requires the native Scarlet WebCore target")
endif ()
if (USE_THIN_ARCHIVES)
    message(FATAL_ERROR "ScarletWebView installation requires self-contained archives; set USE_THIN_ARCHIVES=OFF")
endif ()
include("${CMAKE_CURRENT_LIST_DIR}/../../../scarlet/ScarletStaticLink.cmake")
add_library(ScarletWebView STATIC
    "${CMAKE_CURRENT_LIST_DIR}/ScarletWebView.cpp"
    "${CMAKE_CURRENT_LIST_DIR}/ScarletFrameLoaderClient.cpp"
    "${CMAKE_CURRENT_LIST_DIR}/ScarletEditorClient.cpp"
    "${CMAKE_CURRENT_LIST_DIR}/ScarletLiveLoader.cpp"
    "${CMAKE_CURRENT_LIST_DIR}/ScarletStorage.cpp"
    "${CMAKE_SOURCE_DIR}/Source/WebKitLegacy/Storage/InProcessIDBServer.cpp"
    "${CMAKE_SOURCE_DIR}/Source/WebKitLegacy/Storage/WebStorageNamespaceProvider.cpp"
    "${CMAKE_SOURCE_DIR}/Source/WebKitLegacy/Storage/StorageNamespaceImpl.cpp"
    "${CMAKE_SOURCE_DIR}/Source/WebKitLegacy/Storage/StorageAreaImpl.cpp"
    "${CMAKE_SOURCE_DIR}/Source/WebKitLegacy/Storage/StorageAreaSync.cpp"
    "${CMAKE_SOURCE_DIR}/Source/WebKitLegacy/Storage/StorageSyncManager.cpp"
    "${CMAKE_SOURCE_DIR}/Source/WebKitLegacy/Storage/StorageTracker.cpp"
    "${CMAKE_SOURCE_DIR}/Source/WebKitLegacy/Storage/StorageThread.cpp"

    "${CMAKE_CURRENT_LIST_DIR}/ScarletChromeClient.cpp"
    "${CMAKE_CURRENT_LIST_DIR}/ScarletBackForwardClient.cpp"
)
# Legacy storage sources normally receive their platform configuration from
# their parent target. This embedding builds them with WebCore's native config.
set_source_files_properties(
    "${CMAKE_SOURCE_DIR}/Source/WebKitLegacy/Storage/InProcessIDBServer.cpp"
    "${CMAKE_SOURCE_DIR}/Source/WebKitLegacy/Storage/WebStorageNamespaceProvider.cpp"
    "${CMAKE_SOURCE_DIR}/Source/WebKitLegacy/Storage/StorageNamespaceImpl.cpp"
    "${CMAKE_SOURCE_DIR}/Source/WebKitLegacy/Storage/StorageAreaImpl.cpp"
    "${CMAKE_SOURCE_DIR}/Source/WebKitLegacy/Storage/StorageAreaSync.cpp"
    "${CMAKE_SOURCE_DIR}/Source/WebKitLegacy/Storage/StorageSyncManager.cpp"
    "${CMAKE_SOURCE_DIR}/Source/WebKitLegacy/Storage/StorageTracker.cpp"
    "${CMAKE_SOURCE_DIR}/Source/WebKitLegacy/Storage/StorageThread.cpp"
    PROPERTIES COMPILE_OPTIONS "-include;${CMAKE_BINARY_DIR}/cmakeconfig.h;-include;${WEBCORE_DIR}/config.h")
set_target_properties(ScarletWebView PROPERTIES
    OUTPUT_NAME ScarletWebView
    CXX_STANDARD 23
    CXX_STANDARD_REQUIRED YES
    CXX_EXTENSIONS NO
)
scarlet_attach_engine(ScarletWebView)
target_include_directories(ScarletWebView PRIVATE "${CMAKE_CURRENT_LIST_DIR}" "${CMAKE_SOURCE_DIR}/Source/WebKitLegacy/Storage")
if (NOT SCARLET_EMBEDDING_RUNTIME_LIBRARIES)
    message(FATAL_ERROR "The embedding requires the complete native C/C++ runtime archive list")
endif ()
foreach (_archive IN LISTS SCARLET_EMBEDDING_RUNTIME_LIBRARIES)
    _scarlet_check_archive("${_archive}")
endforeach ()

# Raw LLD arguments are consumed by the final Rust executable's build script.
# A sys-crate rlib cannot propagate these final executable link arguments.
set(_scarlet_manifest "# Native Scarlet WebCore closure; generated by CMake.\ntarget=aarch64-unknown-scarlet\n")
set(_scarlet_embedding_options --no-pie ${SCARLET_EMBEDDING_LINK_OPTIONS})
list(REMOVE_DUPLICATES _scarlet_embedding_options)
foreach (_option IN LISTS _scarlet_embedding_options)
    if (_option MATCHES "[\r\n]" OR NOT _option MATCHES "^--")
        message(FATAL_ERROR "Invalid raw LLD embedding option: ${_option}")
    endif ()
    string(APPEND _scarlet_manifest "${_option}\n")
endforeach ()
string(APPEND _scarlet_manifest "--start-group\n")
set(_scarlet_manifest_build "${_scarlet_manifest}$<TARGET_FILE:ScarletWebView>\n")
set(_scarlet_manifest_installed "${_scarlet_manifest}\${CMAKE_INSTALL_PREFIX}/lib/$<TARGET_FILE_NAME:ScarletWebView>\n")
foreach (_engine IN LISTS _scarlet_engine_targets)
    string(APPEND _scarlet_manifest_build "$<TARGET_FILE:${_engine}>\n")
    string(APPEND _scarlet_manifest_installed "\${CMAKE_INSTALL_PREFIX}/lib/$<TARGET_FILE_NAME:${_engine}>\n")
endforeach ()
foreach (_dependency IN LISTS _scarlet_dependency_targets)
    string(APPEND _scarlet_manifest_build "$<TARGET_FILE:${_dependency}>\n")
    string(APPEND _scarlet_manifest_installed "$<TARGET_FILE:${_dependency}>\n")
endforeach ()
set(_scarlet_manifest_archives ${_scarlet_private_archives} ${SCARLET_EMBEDDING_RUNTIME_LIBRARIES})
list(REMOVE_DUPLICATES _scarlet_manifest_archives)
foreach (_archive IN LISTS _scarlet_manifest_archives)
    string(APPEND _scarlet_manifest_build "${_archive}\n")
    string(APPEND _scarlet_manifest_installed "${_archive}\n")
endforeach ()
string(APPEND _scarlet_manifest_build "--end-group\n")
string(APPEND _scarlet_manifest_installed "--end-group\n")
file(GENERATE OUTPUT "${CMAKE_BINARY_DIR}/ScarletWebView.link" CONTENT "${_scarlet_manifest_build}")

add_executable(ScarletWebViewSmoke EXCLUDE_FROM_ALL
    "${CMAKE_CURRENT_LIST_DIR}/tests/ScarletWebViewSmoke.cpp"
    "${CMAKE_CURRENT_LIST_DIR}/../../../scarlet/DirectRenderer/ScarletAbortTrace.cpp"
)
set_target_properties(ScarletWebViewSmoke PROPERTIES
    OUTPUT_NAME scarlet-webview-smoke
    RUNTIME_OUTPUT_DIRECTORY "${CMAKE_BINARY_DIR}/bin"
    CXX_STANDARD 23 CXX_STANDARD_REQUIRED YES CXX_EXTENSIONS NO
)
foreach (_property INCLUDE_DIRECTORIES COMPILE_DEFINITIONS COMPILE_OPTIONS)
    set_property(TARGET ScarletWebViewSmoke APPEND PROPERTY ${_property}
        "$<TARGET_PROPERTY:WebCore,${_property}>")
endforeach ()
foreach (_engine IN LISTS _scarlet_engine_targets)
    if (TARGET "${_engine}_PostBuild")
        target_include_directories(ScarletWebViewSmoke PRIVATE
            "$<TARGET_PROPERTY:${_engine}_PostBuild,INTERFACE_INCLUDE_DIRECTORIES>")
        target_compile_definitions(ScarletWebViewSmoke PRIVATE
            "$<TARGET_PROPERTY:${_engine}_PostBuild,INTERFACE_COMPILE_DEFINITIONS>")
    endif ()
endforeach ()
# ScarletWebView already contains the real PCH subtarget objects. Do not add
# them to this executable again: it consumes the same physical archive closure
# exported for Rust hosts.
add_dependencies(ScarletWebViewSmoke ScarletWebView)
set(_scarlet_smoke_group "$<TARGET_FILE:ScarletWebView>" ${_scarlet_static_group} ${SCARLET_EMBEDDING_RUNTIME_LIBRARIES})
list(REMOVE_DUPLICATES _scarlet_smoke_group)
list(JOIN _scarlet_smoke_group "," _scarlet_smoke_group_argument)
target_link_libraries(ScarletWebViewSmoke PRIVATE
    "$<LINK_GROUP:RESCAN,${_scarlet_smoke_group_argument}>" Threads::Threads)
foreach (_option IN LISTS _scarlet_embedding_options)
    target_link_options(ScarletWebViewSmoke PRIVATE "LINKER:${_option}")
endforeach ()
target_link_options(ScarletWebViewSmoke PRIVATE
    "LINKER:--wrap=abort" "LINKER:--wrap=_Z16WTFCrashWithInfoiPKcS0_")

# Installation regenerates engine paths from the actual --prefix, while native
# SDK/dependency inputs keep their validated producer paths.
file(GENERATE OUTPUT "${CMAKE_BINARY_DIR}/ScarletWebViewInstallManifest.cmake" CONTENT
    "file(MAKE_DIRECTORY \"\$ENV{DESTDIR}\${CMAKE_INSTALL_PREFIX}/share/scarlet\")\nfile(WRITE \"\$ENV{DESTDIR}\${CMAKE_INSTALL_PREFIX}/share/scarlet/ScarletWebView.link\" \"${_scarlet_manifest_installed}\")\n")
install(TARGETS ScarletWebView ${_scarlet_engine_targets} ARCHIVE DESTINATION lib)
install(FILES "${CMAKE_CURRENT_LIST_DIR}/ScarletWebView.h" DESTINATION include)
install(SCRIPT "${CMAKE_BINARY_DIR}/ScarletWebViewInstallManifest.cmake")
